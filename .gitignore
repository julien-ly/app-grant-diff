# Reports produced by the README examples, anchored to the root so that
# samples/output.json stays tracked.
/report.json
/run-*.json

# Output written by the lab scripts: manifests, registry and reports. They carry
# the tenant id and the object identifiers of whatever tenant they ran against,
# and are regenerated by lab/agd-lab-corpus.ps1 on demand.
lab/agd-lab-out/

*.tmp
lab/agd-lab-marque-invalides.ps1
